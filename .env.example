# Block Boom — نمونهٔ متغیرهای محیطی
#
# این فایل را به .env کپی کن و مقادیر واقعی را داخلش بگذار، یا همین
# متغیرها را در پنل هاست (cPanel/DirectAdmin) تعریف کن. بعد .env را
# نگه دار و این فایل را commit کن.
#
# چرا؟ چون admin/config.php و api/config.php داخل وب‌روت هستند. با
# .htaccess مسدود شده‌اند، ولی اگر روزی LFI یا فایل بکاپی لو برود،
# هر چیزی که آنجا نوشته شده از دست می‌رود. محیط، تنها جایی است که
# راز واقعاً امن است.

# ── دیتابیس ──────────────────────────────────────────────────────────────
BB_DB_HOST=localhost
BB_DB_NAME=database_name
BB_DB_USER=database_user
BB_DB_PASS=CHANGE_ME

# ── پنل مدیریت ───────────────────────────────────────────────────────────
BB_ADMIN_USER=admin

# هش رمز. با این دستور بساز:
#   php -r "echo password_hash('رمزجدید', PASSWORD_DEFAULT), PHP_EOL;"
# بعد از ساخت، BB_ADMIN_PASS (رمز متن ساده) را از کانفیگ حذف کن.
BB_ADMIN_PASS_HASH=

# فقط برای اولین ورود، تا وقتی هش بالا را پر کنی
BB_ADMIN_PASS=

# ── API ──────────────────────────────────────────────────────────────────
BB_API_BASE=https://api.example.com

# کلید امضای توکن اجرای بازی. هرگز نباید داخل اپلیکیشن برود.
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
BB_RUN_TOKEN_SECRET=

# کلید احراز هویت endpoint اعلان‌ها
#   php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
BB_ADMIN_API_KEY=

# کلید امضای قدیمی پیام‌ها. توجه: این کلید داخل APK هست و عملاً
# عمومی است — برای امنیت به آن تکیه نکن.
BB_HMAC_SECRET=

# Origin مجاز مرورگر برای CORS. خالی یعنی هیچ originی مجاز نیست.
BB_ALLOWED_ORIGIN=

# ── آی‌پی ────────────────────────────────────────────────────────────────
# اگر واقعاً پشت Cloudflare یا یک پراکسی خودت هستی، هدر قابل اعتماد را
# اینجا بگذار تا آی‌پی واقعی خوانده شود. خالی بگذار اگر نه.
# نمونه: HTTP_CF_CONNECTING_IP
BB_TRUSTED_PROXY_HEADER=
